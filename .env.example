SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
APP_URL=http://localhost:3002
GOOGLE_OAUTH_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_PICKER_API_KEY=YOUR_BROWSER_RESTRICTED_API_KEY
GOOGLE_CLOUD_PROJECT_NUMBER=YOUR_NUMERIC_PROJECT_NUMBER

# Optional Gemini fallback: extracts company names from unmatched Gmail scan
# emails. Without a key, matching stays regex-only. GEMINI_MAX_CALLS caps
# model calls per scan (set 0 to disable).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_CALLS=10

# Auto-confirm scan candidates that have company+role+status and a unique
# application match: updates the stage, syncs the Sheet, marks dismissed.
# Set 0 to disable and review every candidate manually.
GMAIL_AUTO_CONFIRM=1

# Gmail scan beta access. Only the addresses listed here, before the
# deadline, reach the Gmail routes without a subscription. The list is
# comma-separated, matching ignores case and surrounding spaces, and an
# empty entry is harmless. The deadline must state its own timezone:
# there is no default, and a value the app cannot parse counts as already
# expired rather than as open-ended access.
BETA_TESTER_EMAILS=beta-one@example.com,beta-two@example.com
BETA_ENDS_AT=2026-09-30T23:59:59+08:00

# Switches the Gmail gate on outside the test environment. It stays off
# here on purpose, so a deploy cannot revoke access by itself. Set 1 only
# after BETA_TESTER_EMAILS is filled in, otherwise every user without a
# subscription loses Gmail scan, including the testers you meant to keep.
GMAIL_GATE_ENFORCED=0
